# Environment Settings
ENVIRONMENT=development
AWS_REGION=ap-south-1

# Configuration Source: set to true to fetch parameters from AWS SSM Parameter Store
USE_SSM_CONFIG=false
SSM_PREFIX=/pdfapp

# Database Configuration
# Local Development: postgresql://postgres:postgres@localhost:5432/pdfapp
# Production (Amazon RDS PostgreSQL with SSL required):
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>?sslmode=require
# Example: postgresql://cloudpdf_admin:YOUR_PASSWORD_HERE@cloudpdf-postgres.cvckagyk6fse.ap-south-1.rds.amazonaws.com:5432/pdfapp?sslmode=require
DATABASE_URL=
# Alternatively configure discrete parameters:
# DB_HOST=cloudpdf-postgres.cvckagyk6fse.ap-south-1.rds.amazonaws.com
# DB_PORT=5432
# DB_USER=cloudpdf_admin
# DB_PASSWORD=your_db_password_here
# DB_NAME=pdfapp
# DB_SSLMODE=require

# Amazon S3 Bucket
S3_BUCKET_NAME=cloudpdf-studio-storage-2026

# Amazon Cognito User Pool & App Client (must not have a client secret for SPA compatibility)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# CORS Allowed Origins (JSON array or comma-separated URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

